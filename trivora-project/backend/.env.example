# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501

# MySQL - create the database/user before running db:init
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trivora_user
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=trivora_db

# Generate a long random secret for production. Never commit the real .env file.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h

# Optional email notifications for new enquiries (SMTP). If not configured, enquiries still save to MySQL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=trivoratechnologies1@gmail.com
FROM_EMAIL=trivoratechnologies1@gmail.com
